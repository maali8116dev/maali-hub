# Config for scripts/deploy-selfhosted.sh — copy to scripts/.deploy.env (gitignored).
# Never commit real values.

# --- Migrations (Phase 2) ---
# Postgres URL to the self-hosted DB. With an SSH tunnel (ssh -L 5433:127.0.0.1:5432 ...)
# this points at your forwarded local port. Password: Coolify → Supabase service →
# Environment Variables → SERVICE_PASSWORD_POSTGRES.
DB_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5433/postgres"

# --- Edge functions (Phase 4) ---
VPS_HOST="1.2.3.4"                 # or vps.maalihub.com
VPS_USER="deploy"                  # ssh user
# Absolute path to the edge-runtime functions volume on the VPS
# (Coolify → Supabase service → Storages).
FUNCTIONS_VOLUME="/data/coolify/services/<id>/volumes/functions"
# docker container name of the edge-runtime service (docker ps --format '{{.Names}}').
FUNCTIONS_CONTAINER="supabase-edge-functions"

# --- Optional ---
# SSH_KEY="/home/me/.ssh/maali_deploy"   # else uses your default ssh config
# DOCKER="sudo docker"                    # if your VPS user isn't in the docker group
