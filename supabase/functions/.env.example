# Loaded automatically when running local Supabase (npm run supabase:start).
# Copy to supabase/functions/.env — do not commit.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Cloud Translation API (dynamic opportunity content → fr, pt)
# Enable "Cloud Translation API" in GCP. Use an unrestricted key or IP-restricted for server calls — not HTTP referrer only.
GOOGLE_CLOUD_TRANSLATE_API_KEY=

# Cloudflare Turnstile secret key (server-side verification).
# Required in production — rate-limited-auth, submit-application, and
# submit-contact reject requests when this is unset unless running locally.
TURNSTILE_SECRET_KEY=
